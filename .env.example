# Copier en .env puis remplir. Générer chaque secret avec : openssl rand -base64 36 | tr -d '\n'

# localhost en local ; sur la VM Énov : <IP-avec-tirets>.sslip.io (voir docs/vm.md)
DOMAIN=localhost

AUTHENTIK_SECRET_KEY=
AUTHENTIK_DB_PASSWORD=
# Mot de passe du compte akadmin
AUTHENTIK_BOOTSTRAP_PASSWORD=
# Partagé entre le provider Authentik (blueprint) et Rallly
RALLLY_OIDC_CLIENT_SECRET=
# Mot de passe des comptes de démo alice, bob et charlie
DEMO_PASSWORD=

RALLLY_DB_PASSWORD=
# 32 caractères minimum
RALLLY_SECRET_PASSWORD=
SUPPORT_EMAIL=support@example.com

# Image Rallly : image officielle par défaut, image du fork publiée par la CI ensuite
# RALLLY_IMAGE=ghcr.io/les-salopards/rallly:latest
